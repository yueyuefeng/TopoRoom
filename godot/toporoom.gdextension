[configuration]

entry_symbol = "toporoom_library_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

linux.debug.x86_64 = "res://bin/libtoporoom.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libtoporoom.linux.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libtoporoom.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libtoporoom.android.template_release.arm64.so"
android.debug.x86_64 = "res://bin/libtoporoom.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/libtoporoom.android.template_release.x86_64.so"

[dependencies]

linux.debug.x86_64 = {}
linux.release.x86_64 = {}
android.debug.arm64 = {}
android.release.arm64 = {}
android.debug.x86_64 = {}
android.release.x86_64 = {}
