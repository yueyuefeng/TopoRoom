; Engine configuration file.
; Godot 4 read-only roam host. Does not write SceneIR or dimensions (I7 / I8).
config_version=5

[application]
config/name="TopoRoom Roam"
run/main_scene="res://roam.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[rendering]
renderer/rendering_method="forward_plus"
