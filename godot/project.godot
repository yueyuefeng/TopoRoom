; 拓间 TopoRoom — Godot 4 InteractionShell / Visualization host.
; Edits: Godot UI / 3D gizmos → GDExtension (toporoom.gdextension) → C API → FloorPlanDocument (SceneIR).
; .glb roam is read-only (I7 mesh / I8 VisualizationDerivative). 3D edit
; meshes are previews; millimetres come only from commands (ADR-002).
config_version=5

[application]

config/name="拓间 TopoRoom"
config/description="户型图量房宿主：命令编辑 SceneIR，3D 手柄写回，glb 只读漫游"
run/main_scene="res://app/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Session="*res://app/session.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=720
window/size/window_height_override=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[internationalization]

locale/fallback="zh_CN"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
